# Contoh konfigurasi variabel lingkungan SI-PAKAINGE MONSA
# Salin menjadi .env di ROOT project — server/app.py kini membacanya OTOMATIS
# saat start (loader stdlib, tanpa dependensi ekstra).
# Variabel yang SUDAH di-set di shell/systemd tidak pernah ditimpa.
#
# Untuk penggunaan manual tanpa file .env:
#   set -a; . ./.env; set +a
#   python3 server/app.py

PORT=8000

# --- JARINGAN ---
# Alamat bind backend. Default 127.0.0.1 (hanya localhost, di belakang nginx).
# Set 0.0.0.0 hanya bila perlu diakses langsung dari device lain (demo LAN).
MONSA_BIND=

# --- KEAMANAN (wajib di produksi) ---
# Kunci penanda token autentikasi. Tanpa ini server MENOLAK start dalam mode produksi.
# Buat dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
# Di pengembangan (tanpa env), server memakai kunci acak sementara sehingga
# sesi tidak bertahan setelah server berhenti.
MONSA_SECRET_KEY=

# "production" | "prod" memaksa validasi ketat (kunci wajib & minimal 32 karakter).
# Biarkan kosong saat pengembangan.
MONSA_ENV=

# --- MODE DEMO ---
# 1 = matikan sepenuhnya di produksi (endpoint demo-switch & daftar akun demo disembunyikan).
# 0/dev = demo-switch tetap ada, tetapi kini WAJIB login sebagai admin sekolah terverifikasi.
MONSA_DISABLE_DEMO=1

# --- CORS (default KETAT: tanpa izin lintas-origin) ---
# Pisahkan dengan koma. Gunakan "*" hanya bila memang butuh akses dari mana pun.
# Contoh: https://lapor.sdnungmongisidi1.sch.id,https://cms.sekolah.sch.id
MONSA_CORS_ORIGINS=

# --- PROXY TEPERCAYA ---
# IP proxy (nginx) yang boleh menyetel X-Real-IP / X-Forwarded-For.
# Loopback selalu dipercaya; tambahkan lain bila ada di belakang LB.
# Contoh: 10.0.0.5, 172.16.0.10
MONSA_TRUSTED_PROXIES=

# --- TAUTAN RESMI (opsional) ---
MONSA_APK_URL=
MONSA_WEB_URL=

# --- NOTIFIKASI (opsional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
MONSA_WEBHOOK_URL=

# --- Build frontend khusus APK agar otomatis mengarah ke domain server sekolah: ---
# VITE_API_BASE_URL=https://lapor.sdnungmongisidi1.sch.id
